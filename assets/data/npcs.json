[
  {
    "id": "wandering_merchant",
    "name": "流浪商人",
    "description": "背着旧货箱的商人，眼神谨慎。",
    "dialogueId": "dialogue_wandering_merchant",
    "shopId": "wandering_merchant_shop",
    "inquiries": [
      {
        "id": "name",
        "label": "姓名",
        "aliases": ["name", "名字"],
        "response": "我不过是个走南闯北的货郎，江湖人都叫我流浪商人。"
      },
      {
        "id": "here",
        "label": "这里",
        "aliases": ["here", "此地"],
        "response": "这村子荒了有些年头，最近却总有人往林子和老井那边去。"
      }
    ],
    "interactions": [
      {
        "type": "trade",
        "label": "交易",
        "itemIds": ["small_potion", "bread"]
      }
    ]
  },
  {
    "id": "guard",
    "name": "守卫",
    "description": "疲惫但仍尽责的村口守卫。",
    "dialogueId": "dialogue_guard",
    "inquiries": [
      {
        "id": "name",
        "label": "姓名",
        "aliases": ["name", "名字"],
        "response": "我只是守这村口的人，名字不值一提。"
      },
      {
        "id": "herb",
        "label": "止血草",
        "aliases": ["草药", "止血草", "herb"],
        "response": "止血草叶色发暗，常长在潮湿背阴处。若能寻来三株，巡林人也许还能撑过去。",
        "eventIds": ["event_talk_guard_herb"]
      }
    ],
    "acceptedItems": [
      {
        "itemId": "healing_herb",
