        "eventIds": ["event_talk_guard_herb"]
      }
    ]
  },
  {
    "id": "little_girl",
    "name": "小女孩",
    "description": "躲在屋檐下的小女孩，像是知道一些线索。",
    "dialogueId": "dialogue_little_girl",
    "inquiries": [
      {
        "id": "well",
        "label": "老井",
        "aliases": ["井", "老井", "well"],
        "response": "我看见有人提着灯往老井去了，灯光很快就不见了。"
      },
      {
        "id": "stranger",
        "label": "陌生人",
        "aliases": ["人", "陌生人"],
        "response": "那人穿着灰衣，走路很轻，不像村里人。"
      }
    ]
  },
